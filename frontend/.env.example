# Vite bakes this into the built JS at COMPILE time (not read at runtime
# like a typical backend env var) — see api/client.js and the other files
# reading import.meta.env.VITE_API_URL. Copy to .env.local for local
# overrides (Vite's own convention); leave unset to use the default
# (http://localhost:9090) baked into every file that reads it.
#
# Not a secret — this is just which backend origin the built app should
# call, always visible in the shipped JS bundle regardless of how it's
# set. Documented here mainly so it isn't rediscovered by grepping for
# "localhost:9090" the way it had to be found this engagement.
VITE_API_URL=http://localhost:9090

# ── Auth0 (optional) ────────────────────────────────────────────
# Also baked in at build time, like VITE_API_URL above. Leave both blank
# to keep using the shared development Auth0 tenant (fine for local
# dev/demo only — see src/config/auth0.js). Set BOTH to a real tenant's
# values before any real deployment; until you do, isAuth0Configured is
# false and the app hides all Auth0-backed login buttons rather than
# authenticate real users against the shared dev tenant.
#
# Get these from https://manage.auth0.com -> Applications -> your SPA app
# -> Settings (Domain, Client ID). Not secrets — Auth0 SPA client IDs are
# public by design — but still worth setting per-environment.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=

# ── Error tracking (optional) ────────────────────────────────────
# Get a DSN from https://sentry.io (or a self-hosted Sentry instance).
# Also baked in at build time, like the vars above. Leave blank: client-
# side errors go uncaptured (previous behavior) — see
# src/config/errorTracking.js.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
