# HOW THIS FILE IS USED: copy it to a file named ".env" and fill it in. The backend reads that file by itself
# (from /etc/secrets/.env — a Render "Secret File" — or ./.env next to where it runs); Docker Compose also
# passes it in. Real environment variables, if set, override it. Never commit the real .env (it is git-ignored).
#
# Every environment variable Prowosma's backend actually reads, extracted
# directly from application.properties — not a generic template. Copy to
# `.env` for local use (already gitignored — verify that before committing
# anything), or use this as the checklist for whatever secrets manager
# (AWS Secrets Manager, Vault, etc.) or CI/CD secret store a real
# deployment uses. No real values below, only placeholders/examples.
#
# This file existing at all is new — there was previously no single place
# that told you every variable a deployment needs to set.

# ── Database ─────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGO_DB=prowosma

# ── Auth ─────────────────────────────────────────────────────────
# REQUIRED in any real deployment — see application-prod.properties. The
# default in application.properties is a real, published-in-this-repo
# value; using it anywhere but local dev makes every JWT this app issues
# forgeable. Generate a real one, e.g.: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Auth0 domain/client ID — NOT secrets (Auth0 SPA client IDs are public by
# design, already visible in this app's own frontend bundle/devtools) but
# still worth setting per-environment rather than relying on the
# hardcoded dev-tenant default in application.properties and main.jsx.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=

# ── SAML SSO (optional — leave blank to disable) ───────────────────
SAML_OKTA_METADATA_URL=
SAML_AZURE_METADATA_URL=
SAML_GOOGLE_METADATA_URL=
SAML_CUSTOM_METADATA_URL=
SAML_CUSTOM_REG_ID=custom

# ── Email — any SMTP-compatible provider ─────────────────────────────
# Works unchanged with Amazon SES, SendGrid, Postmark, Mailgun, a
# self-hosted relay, or Gmail. See docs/EMAIL_SETUP.md for the exact
# host/port values per provider and how to wire bounce/complaint webhooks.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Prowosma
# Legacy aliases — still read as a fallback if the SMTP_* vars above are
# unset, so existing Gmail-based deployments keep working unchanged.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# Optional — set this to send via Resend's HTTPS API instead of SMTP.
# Needed on hosts that block outbound SMTP ports (e.g. Render's free
# web-service tier blocks 25/465/587 entirely). Leave blank to keep using
# the SMTP_* config above unchanged. See docs/EMAIL_SETUP.md.
RESEND_API_KEY=

# Shared secret the bounce/complaint webhook endpoints (EmailWebhookController)
# require via ?secret=... or X-Webhook-Secret — required once those
# endpoints are reachable from the internet, see docs/EMAIL_SETUP.md.
EMAIL_WEBHOOK_SECRET=

# ── Field-level encryption (optional but recommended for real deployments) ──
# Generate with: openssl rand -base64 32
# Protects sensitive values stored in MongoDB (currently: per-workspace
# SMTP passwords) with AES-256-GCM. See docs/SECURITY_HARDENING.md.
ENCRYPTION_KEY=

# ── Stripe / Billing (optional — leave blank, billing silently no-ops) ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=

# ── URLs / CORS ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
WS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Tenant isolation guard ───────────────────────────────────────
# Stops one workspace reading/editing/deleting another workspace's records by id.
#   enforce (default) - block it
#   log               - report it as a WARN but let it through (to trial against real traffic)
#   off               - do not install the guard
TENANT_GUARD_MODE=enforce

# ── Integrations ─────────────────────────────────────────────────
# Self-managed GitLab on a private network? Set true (https is still required).
INTEGRATIONS_ALLOW_PRIVATE_HOSTS=false

# -- Client IP / trusted proxies ----------------------------------
# Proxies whose X-Forwarded-For / X-Real-IP headers are believed: comma-separated IPs or CIDR ranges.
# Empty = loopback + private ranges only (a proxy on your own network).
# Behind a proxy or CDN that connects from a PUBLIC address (e.g. Cloudflare)? List its ranges here,
# otherwise all users share one rate-limit bucket and IP allow-lists reject everyone.
# Example: TRUSTED_PROXIES=203.0.113.10,198.51.100.0/24
TRUSTED_PROXIES=
# Extra Teams webhook host suffixes for sovereign clouds, comma-separated.
TEAMS_EXTRA_HOST_SUFFIXES=

# ── Misc ─────────────────────────────────────────────────────────
FILE_UPLOAD_DIR=uploads

# ── File storage — object storage (optional) ────────────────────────
# Leave FILE_STORAGE_PROVIDER unset/=local to keep the existing local-disk
# behavior (FILE_UPLOAD_DIR above). Set =s3 to store attachments in Amazon
# S3 or any S3-compatible service instead. See docs/FILE_STORAGE_SETUP.md.
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_S3_BUCKET=
FILE_STORAGE_S3_REGION=us-east-1
# Blank = real AWS S3. Set for MinIO/R2/B2/Spaces, e.g. http://localhost:9000
FILE_STORAGE_S3_ENDPOINT=
FILE_STORAGE_S3_KEY_PREFIX=attachments/
# Standard AWS credential env vars (picked up automatically by the AWS SDK
# — not custom to this app): AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# or an IAM instance/task role in real AWS deployments (preferred — no
# long-lived key to leak). Also works for MinIO's own access/secret keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Malware scanning for uploads (optional) ──────────────────────────
VIRUS_SCAN_PROVIDER=none
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
VIRUS_SCAN_FAIL_CLOSED=false
RATE_LIMIT_RPM=300
DEPLOYMENT_REGION=US

# ── Data residency — real per-region routing (optional) ──────────────
# Leave all blank for the existing single-database behavior. Set one or
# more to give this deployment a genuine, distinct MongoDB connection per
# region — required before WorkspaceService will let a workspace declare
# that region. See docs/DATA_RESIDENCY.md.
MONGODB_URI_US=
MONGODB_URI_EU=
MONGODB_URI_UK=
MONGODB_URI_APAC=
ALLOW_UNENFORCED_DATA_REGION=false

# ── Web Push (VAPID) — optional ───────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# ── Observability ────────────────────────────────────────────────
# `docker compose up` now runs a real local trace pipeline (OTel Collector
# + Jaeger UI at http://localhost:16686), so the default below is genuinely
# live in local dev, not inert. See docs/OBSERVABILITY_SETUP.md for how to
# point this at Grafana Tempo/Cloud, Honeycomb, Datadog, New Relic, or any
# other OTLP-compatible backend instead — every value here is config-only,
# no code change required either way.
APPLICATION_NAME=prowosma-backend
DEPLOYMENT_ENV=development
OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
OTLP_TRACING_TIMEOUT=10s
OTLP_TRACING_COMPRESSION=gzip
# 1.0 = trace every request (fine for dev / low traffic). Lower this
# (e.g. 0.1 = 10%) before pointing at a paid hosted trace backend under
# real production traffic.
OTEL_TRACING_SAMPLING_PROBABILITY=1.0
# Only needed for hosted vendors that require an auth header (Honeycomb,
# Grafana Cloud, some Datadog/New Relic OTLP endpoints). Format:
# "Header-Name=value". Leave blank for a self-hosted collector (Jaeger/
# Tempo/your own OTel Collector), which normally needs no auth header.
OTLP_TRACING_AUTH_HEADER=

# ── Meeting Assistant: Google Meet transcript import (optional) ─────────────────
# Docker Compose: put these in a file named ".env" next to docker-compose.yml (docker-compose.yml passes them in).
# Spring does NOT read .env by itself: for local runs use real environment variables; on Render use the Environment tab.
# Create an OAuth client (Web application) in Google Cloud with the Google Meet REST API enabled.
# Authorized redirect URI: ${FRONTEND_URL}/integrations/meeting-platforms/google-callback
# ENCRYPTION_KEY (above / base64 of 32 random bytes) is REQUIRED: saved sign-ins are only stored encrypted.
GOOGLE_MEET_OAUTH_CLIENT_ID=
GOOGLE_MEET_OAUTH_CLIENT_SECRET=
# GOOGLE_MEET_OAUTH_REDIRECT_URI=
# app.meeting-assistant.jobs-enabled=true            (set false to stop the background poller)
# app.meeting-assistant.job-poll-ms=15000
# app.meeting-assistant.dev-fixtures-enabled=false   (true allows clearly-labelled SIMULATED meetings)

# ── Meeting Assistant: summaries, minutes and notes ─────────────────────────────
# Uses the AI provider/key/model configured per workspace under AI Settings (no key goes here).
# app.meeting-assistant.ai-max-generations-per-hour=20
# app.meeting-assistant.ai-single-pass-chars=90000      (longer transcripts are analysed in parts)
# app.meeting-assistant.ai-chunk-chars=60000
# app.meeting-assistant.ai-max-output-tokens=8000

# ═══════════════════════════════════════════════════════════════════════════
#  MICROSOFT TEAMS  (Meeting Assistant — automatic transcript import)  — OPTIONAL
# ═══════════════════════════════════════════════════════════════════════════
# Leave both values EMPTY to keep Teams automatic import off (people can still
# upload/paste Teams transcripts). Step-by-step guide: docs/TEAMS_SETUP.md
# These two belong to the "app registration" a Microsoft 365 admin creates for Prowosma.
#
# ---- 1) Application (client) ID ---------------------------------------------
# Get it from: Microsoft Entra admin center (entra.microsoft.com) -> Identity ->
#   Applications -> App registrations -> "Prowosma Meeting Assistant" -> Overview ->
#   "Application (client) ID".
# It looks like:  11111111-2222-3333-4444-555555555555
TEAMS_GRAPH_CLIENT_ID=

# ---- 2) Client secret VALUE ---------------------------------------------------
# Get it from: the same app -> Certificates & secrets -> New client secret.
# Copy the "Value" column (NOT "Secret ID") right away — Microsoft shows it only once.
# Note its expiry date: renew it before then. Treat it like a password.
TEAMS_GRAPH_CLIENT_SECRET=

# The Microsoft "Directory (tenant) ID" is NOT set here: an admin types it in the app
# (Integrations -> Microsoft Teams Meetings -> "Microsoft tenant id").
